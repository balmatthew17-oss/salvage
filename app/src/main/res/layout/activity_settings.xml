<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/round_dark"
                android:gravity="center"
                android:text="←"
                android:textColor="@color/text"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="Settings"
                android:textColor="@color/text"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView style="@style/Section" android:text="EBAY API KEYS" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:lineSpacingExtra="2dp"
            android:text="From your Production keyset on the eBay developer site. They stay on this phone."
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/dev_link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="Open developer.ebay.com →"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView style="@style/Label" android:text="App ID (Client ID)" />

        <EditText
            android:id="@+id/client_id"
            style="@style/Field"
            android:hint="YourName-Salvage-PRD-…"
            android:inputType="text|textNoSuggestions" />

        <TextView style="@style/Label" android:text="Cert ID (Client Secret)" />

        <EditText
            android:id="@+id/client_secret"
            style="@style/Field"
            android:hint="PRD-…"
            android:inputType="textPassword" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/test"
                style="@style/Button"
                android:text="Test keys" />

            <TextView
                android:id="@+id/test_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView style="@style/Section" android:text="WHAT TO LOOK FOR" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Max price includes postage."
            android:textColor="@color/muted"
            android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <Switch
                    android:id="@+id/on_ps5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="PS5"
                    android:textColor="@color/text"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="max £"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/max_ps5"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/field"
                    android:hint="150"
                    android:inputType="number"
                    android:maxLength="4"
                    android:padding="10dp"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textColorHint="@color/muted"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <Switch
                    android:id="@+id/on_xsx"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Xbox Series X"
                    android:textColor="@color/text"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="max £"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/max_xsx"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/field"
                    android:hint="130"
                    android:inputType="number"
                    android:maxLength="4"
                    android:padding="10dp"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textColorHint="@color/muted"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <Switch
                    android:id="@+id/on_xss"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Xbox Series S"
                    android:textColor="@color/text"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="max £"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/max_xss"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/field"
                    android:hint="70"
                    android:inputType="number"
                    android:maxLength="4"
                    android:padding="10dp"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textColorHint="@color/muted"
                    android:textSize="15sp" />
            </LinearLayout>

        <TextView style="@style/Section" android:text="CONTROLLERS" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <Switch
                    android:id="@+id/on_ds"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="PS5 DualSense"
                    android:textColor="@color/text"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="max £"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/max_ds"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/field"
                    android:hint="20"
                    android:inputType="number"
                    android:maxLength="4"
                    android:padding="10dp"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textColorHint="@color/muted"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <Switch
                    android:id="@+id/on_xpad"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Xbox controller"
                    android:textColor="@color/text"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="max £"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/max_xpad"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/field"
                    android:hint="15"
                    android:inputType="number"
                    android:maxLength="4"
                    android:padding="10dp"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textColorHint="@color/muted"
                    android:textSize="15sp" />
            </LinearLayout>

        <TextView style="@style/Section" android:text="CHECK FOR NEW LISTINGS" />

        <RadioGroup
            android:id="@+id/interval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card"
            android:orientation="horizontal"
            android:padding="8dp">

            <RadioButton android:id="@+id/int_15" style="@style/Radio" android:text="15 min" />
            <RadioButton android:id="@+id/int_30" style="@style/Radio" android:text="30 min" />
            <RadioButton android:id="@+id/int_60" style="@style/Radio" android:text="1 hour" />
            <RadioButton android:id="@+id/int_off" style="@style/Radio" android:text="Off" />
        </RadioGroup>

        <Switch
            android:id="@+id/notify_risky"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/card"
            android:padding="14dp"
            android:text="Also notify for risky listings (banned, parts missing)"
            android:textColor="@color/text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/unhide"
            style="@style/Button"
            android:layout_marginTop="22dp" />

        <TextView
            android:id="@+id/done"
            style="@style/Button"
            android:layout_width="match_parent"
            android:layout_marginTop="28dp"
            android:background="@drawable/chip_on"
            android:gravity="center"
            android:text="Done"
            android:textColor="@color/bg" />
    </LinearLayout>
</ScrollView>
